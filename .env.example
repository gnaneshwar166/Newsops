# ==============================================================================
# NewsOps Revision 2 - Environment Configuration Template
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# ==============================================================================

# Database Settings (MongoDB 7)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=newsops
MONGODB_TIMEOUT_MS=5000

# Application Environment & Server Settings
APP_NAME=NewsOps
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
SESSION_SECRET=dev-secret-key-change-in-production-must-be-32-chars!

# Security & Agent Authentication
AGENT_API_TOKEN=dev-agent-secret-token-change-me
NEWSOPS_API=http://localhost:8000/api/v1

# Ingestion Limits & Budgets
TASK_MAX_ARTICLES=60
TASK_MAX_COST_USD=0.50

# Allow-listed Fetch Domains (SSRF Protection)
ALLOWED_FETCH_DOMAINS=github.com,api.github.com,news.ycombinator.com,hn.algolia.com,oauth.reddit.com,dev.to,export.arxiv.org,api.osv.dev,pypi.org,registry.npmjs.org

# Optional Provider Credentials (V2 Connectors / Optional LLM Fallback)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_API_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=newsops/0.1 (contact: dev@example.com)
PRODUCTHUNT_TOKEN=
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Switch Platform Integration (Day 0 Verification Items)
SWITCH_BASE_URL=
SWITCH_POSTER_AGENT_ID=
SWITCH_POSTER_TOKEN=
